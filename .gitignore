# Secrets
.env
.env.*
credentials.json
token.json
client_secret*.json

# Legacy single-candidate CLI pipeline's own local profile -- real
# personal data (name, salary, etc.), never committed. See
# config/profile.json.example for the tracked generic template; copy
# it to config/profile.json and fill in your own details if you use
# the legacy CLI (scripts/jobos.py / the /jobos skill). The current
# multi-candidate web app never reads this file.
config/profile.json

# Google / OAuth
*.pem
*.key

# Browser sessions and authentication
browser/sessions/
browser/.auth/
playwright/.auth/

# Job application personal data
data/applications/
data/private/
data/backups/
data/*.csv
data/*.xlsx

# Phase 7.2: daily automated search/report artifacts (job_search_report.xlsx,
# run_summary.json, worker.log per data/daily/YYYY-MM-DD/) -- generated
# output, never committed
data/daily/

# Logs
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store

# Temporary files
*.tmp
*.temp
*.swp

# n8n runtime data — contains database and encrypted credentials.
# n8n/workflows/ is real, committed source (importable workflow JSON,
# no secrets/credentials by construction -- see scripts/test_n8n_workflows.py),
# never runtime data, so it's explicitly un-ignored below.
n8n/*
!n8n/workflows/
!n8n/workflows/**

# Personal resume and application data
resumes/
data/applications/
data/private/

# Local test job data
data/test_job*.json
